# Required for live mode. Leave unset to run the offline demo, which drives the
# same code paths using the SDK's TestData source and needs no credentials.
LD_SDK_KEY=your-ld-server-side-sdk-key

# Your LaunchDarkly feature flag keys
LD_CONSOLE_LOG_FLAG_KEY=console-log-level
LD_SDK_LOG_FLAG_KEY=sdk-log-level

# The context log levels are evaluated against
LD_CONTEXT_KEY=checkout-service
LD_ENV=development

# Which loggers the flags control. The console flag defaults to the root logger,
# so it affects every library in the app; narrow it to your own package if that
# is too broad.
# LD_APP_LOGGER_NAME=com.example.checkout
# LD_SDK_LOGGER_NAME=com.launchdarkly

# Seconds between ticks
DEMO_INTERVAL_SECONDS=5

# Every setting above has a command-line equivalent that overrides it.
# Run with --help to see them.
